{
  "name": "sam-greenfield",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:migrate": "node packages/db/src/migrate.js",
    "test:phase0": "python3 tests/phase0/phase0_acceptance.py",
    "test:mcp-internal-oauth": "node --import tsx --test tests/phase21/mcp_internal_oauth.ts",
    "start": "tsx apps/runtime/src/main.ts",
    "start:mcp": "tsx apps/mcp/src/main.ts",
    "mcp:password-hash": "node --import tsx scripts/mcp-password-hash.ts",
    "start:command-center": "tsx apps/command-center/src/main.ts",
    "live:acceptance": "tsx apps/acceptance/src/main.ts"
  },
  "dependencies": {
    "pg": "8.13.1",
    "tsx": "4.19.2",
    "@modelcontextprotocol/server": "2.3.1",
    "@modelcontextprotocol/node": "2.1.1",
    "zod": "4.2.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1"
  }
}
