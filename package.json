{
  "name": "sam-greenfield",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:migrate": "node packages/db/src/migrate.js",
    "test:phase0": "python3 tests/phase0/phase0_acceptance.py",
    "test:phase17:bol-sam": "node --import tsx tests/phase17/bol_sam_surface.ts",
    "test:mcp-internal-oauth": "node --import tsx --test tests/phase21/mcp_internal_oauth.ts",
    "start": "tsx apps/runtime/src/main.ts",
    "start:mcp": "tsx apps/mcp/src/main.ts",
    "mcp:password-hash": "node --import tsx scripts/mcp-password-hash.ts",
    "start:command-center": "tsx apps/command-center/src/main.ts",
    "live:acceptance": "tsx apps/acceptance/src/main.ts",
    "test:sam-google": "node --import tsx --test tests/isolated/sam_google_*.ts tests/phase21/mcp_internal_oauth.ts",
    "evaluate:specialists": "tsx apps/agents/src/evaluation/cli.ts",
    "verify:full": "node scripts/testing/verify-full.cjs",
    "typecheck": "tsc --noEmit",
    "start:release": "node scripts/release/main.cjs",
    "release:check-db": "node --import tsx scripts/release/database-check.ts",
    "release:prepare": "node scripts/release/preparation.cjs",
    "dev:setup": "node scripts/development/setup.cjs",
    "dev:runtime": "node scripts/development/run.cjs runtime",
    "dev:mcp": "node scripts/development/run.cjs mcp",
    "dev:command-center": "node scripts/development/run.cjs command-center",
    "test:development": "node scripts/development/test.cjs",
    "test:development:goal-cycle": "node scripts/development/goal-cycle.cjs --local-acceptance",
    "test:core-reliability": "node scripts/testing/core-reliability.cjs",
    "test:core-regression": "node scripts/testing/core-reliability.cjs --regression"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@modelcontextprotocol/server": "2.3.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "pg": "8.13.1",
    "tsx": "^4.23.15",
    "zod": "4.2.1",
    "@replit/connectors-sdk": "^0.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3"
  }
}
