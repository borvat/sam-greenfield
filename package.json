{
  "name": "sam-greenfield",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:migrate": "node packages/db/src/migrate.js",
    "test:phase0": "python3 tests/phase0/phase0_acceptance.py",
    "test:phase17:bol-sam": "node --import tsx tests/phase17/bol_sam_surface.ts",
    "test:mcp-internal-oauth": "node --import tsx --test tests/phase21/mcp_internal_oauth.ts",
    "start": "tsx apps/runtime/src/main.ts",
    "start:mcp": "tsx apps/mcp/src/main.ts",
    "mcp:password-hash": "node --import tsx scripts/mcp-password-hash.ts",
    "start:command-center": "tsx apps/command-center/src/main.ts",
    "live:acceptance": "tsx apps/acceptance/src/main.ts",
    "test:sam-google": "node --import tsx --test tests/isolated/sam_google_*.ts tests/phase21/mcp_internal_oauth.ts",
    "test:knowledge": "node --import tsx --test tests/isolated/scoped_knowledge.ts tests/isolated/sam_google_review.ts tests/phase22/planner_scope.ts",
    "test:research": "node --import tsx --test tests/isolated/research_engine.ts",
    "test:mcp-expansion": "node --import tsx --test tests/isolated/scoped_mcp_expansion.ts",
    "test:mcp-oss": "node --import tsx scripts/oss-mcp-acceptance.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@modelcontextprotocol/server": "2.3.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "pg": "8.13.1",
    "tsx": "4.19.2",
    "zod": "4.2.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@modelcontextprotocol/client": "2.3.1"
  }
}
