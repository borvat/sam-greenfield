{
  "name": "sam-greenfield",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start:release": "node scripts/release/main.cjs",
    "dev:setup": "node scripts/development/setup.cjs",
    "dev:runtime": "node scripts/development/run.cjs runtime",
    "dev:mcp": "node scripts/development/run.cjs mcp",
    "dev:command-center": "node scripts/development/run.cjs command-center",
    "test:development": "node scripts/development/test.cjs",
    "test:development:goal-cycle": "node scripts/development/goal-cycle.cjs --local-acceptance",
    "db:migrate": "node packages/db/src/migrate.js",
    "test:phase0": "python3 tests/phase0/phase0_acceptance.py",
    "start": "tsx apps/runtime/src/main.ts",
    "start:mcp": "tsx apps/mcp/src/main.ts",
    "start:command-center": "tsx apps/command-center/src/main.ts",
    "live:acceptance": "tsx apps/acceptance/src/main.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@replit/connectors-sdk": "^0.4.3",
    "pg": "8.13.1",
    "tsx": "^4.23.15",
    "zod": "4.2.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1"
  }
}
