# Contract/template only; no values here provision resources or permit publishing.
NODE_ENV=production
SAM_RELEASE_APPROVED=0
# Setup is opt-in and never grants executive activation. This template leaves it OFF.
SAM_RELEASE_SETUP_MODE=0
# Local test switch must never be enabled in production.
SAM_RELEASE_SETUP_LOCAL=0
SAM_WORK_LEASE_MAX_ATTEMPTS=3
SAM_DATABASE_TARGET=production
DATABASE_URL=
# DATABASE_URL is Replit-managed: do not overwrite/request it manually.
# Set this independent app LOGIN URL only in production Secrets after DB approval.
SAM_RELEASE_DATABASE_URL=
SAM_DB_APP_ROLE=sam_app
SAM_DB_SCHEMA=sam
# Native persistent PostgreSQL connection; transaction/session pooler not admitted.
SAM_DB_CONNECTION_MODE=direct
# Both database URL variants must use sslmode=verify-full, with a trusted CA.
SAM_RELEASE_ORG_ID=
SAM_COMMAND_CENTER_LEGAL_ENTITY_ID=
SAM_COMMAND_CENTER_BEARER_TOKEN=
SAM_COMMAND_CENTER_ALLOWED_HOSTS=
SAM_COMMAND_CENTER_ALLOWED_ORIGINS=
SAM_PRODUCTION_BUNDLE_MODULE=apps/production/src/localReleaseBundleModule.ts
SAM_RELEASE_CAPABILITIES=local.calculate,local.statistics
SAM_RELEASE_ENABLE_MCP=0
SAM_MCP_BEARER_TOKEN=
SAM_SHUTDOWN_GRACE_MS=15000
SAM_RELEASE_RESTART_LIMIT=3
# Provider/OAuth secrets are deliberately NOT forwarded by this initial envelope.
# Do not reuse SESSION_SECRET as a production CC/MCP bearer.
