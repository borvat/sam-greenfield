# Configuration names only. Never overwrite the platform DATABASE_URL.
# This is a complete composition outline, NOT launch authorization.
NODE_ENV=production
SAM_RELEASE_APPROVED=0
SAM_RELEASE_SETUP_MODE=0
SAM_DATABASE_TARGET=production
SAM_DB_CONNECTION_SOURCE=replit_managed
SAM_DB_CONNECTION_MODE=direct
# Actual restricted authenticated username; not an owner + SET ROLE substitute.
SAM_DB_APP_ROLE=
SAM_DB_SCHEMA=sam
SAM_RELEASE_ORG_ID=
SAM_COMMAND_CENTER_LEGAL_ENTITY_ID=
SAM_COMMAND_CENTER_BEARER_TOKEN=
SAM_COMMAND_CENTER_ALLOWED_HOSTS=
SAM_COMMAND_CENTER_ALLOWED_ORIGINS=
SAM_PRODUCTION_BUNDLE_MODULE=apps/production/src/syntheticPilotBundleModule.ts
SAM_RELEASE_CAPABILITIES=local.calculate,local.statistics
SAM_RELEASE_ENABLE_MCP=1
SAM_MCP_SYNTHETIC_TOOLS=1
SAM_MCP_OAUTH_APPROVED=0
SAM_MCP_OAUTH_RESOURCE=
SAM_MCP_OAUTH_ISSUER=
SAM_MCP_OAUTH_CLAIM_NAMESPACE=
SAM_MCP_OAUTH_SUBJECT=
SAM_MCP_OAUTH_CLIENT_ID=
SAM_MCP_OAUTH_PUBLIC_JWKS=
SAM_RELEASE_SYNTHETIC_PLANNER=1
SAM_RELEASE_SYNTHETIC_PLANNER_APPROVED=0
SAM_PILOT_RUN_ID=
SAM_PILOT_EXPIRES_AT=
SAM_PILOT_PRICE_REVIEWED_AT=
SAM_PILOT_INPUT_USD_PER_1K=
SAM_PILOT_OUTPUT_USD_PER_1K=
SAM_PILOT_MAX_REQUESTS=1
SAM_PILOT_MAX_COST_USD=0.01
# DEEPSEEK_API_KEY is supplied separately after explicit secret-use approval.
# No OAuth private signing key or DB administrator credential belongs here.
