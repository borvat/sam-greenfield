# SAM Greenfield environment example — never commit real secrets
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sam_greenfield
POSTGRES_DB=sam_greenfield
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
HOST=0.0.0.0
PORT=8080
SAM_WORKER_ID=sam-local
SAM_TICK_INTERVAL_MS=1000
SAM_SHUTDOWN_GRACE_MS=15000
# Required in production: absolute path to a trusted composition module exporting runWorkTick()
SAM_COMPOSITION_MODULE=
