# SAM Greenfield environment example — never commit real secrets
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sam_greenfield
POSTGRES_DB=sam_greenfield
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
HOST=0.0.0.0
PORT=8080
SAM_WORKER_ID=sam-local
SAM_TICK_INTERVAL_MS=1000
SAM_SHUTDOWN_GRACE_MS=15000
# Required in production: absolute path to a trusted composition module exporting runWorkTick()
SAM_COMPOSITION_MODULE=
# Production wiring bundle: trusted module exporting real capabilities/adapters/verifiers
SAM_PRODUCTION_BUNDLE_MODULE=
# ChatGPT / MCP transport
SAM_MCP_PORT=8081
SAM_MCP_HOST=0.0.0.0
SAM_MCP_ACTOR=chatgpt-mcp
# Required in production. Store only in secret manager / deployment environment.
SAM_MCP_BEARER_TOKEN=
# Comma-separated hostnames accepted on the MCP endpoint, e.g. mcp.example.com
SAM_MCP_ALLOWED_HOSTS=
# Optional comma-separated origins. Requests without Origin are allowed.
SAM_MCP_ALLOWED_ORIGINS=

# Real model providers. A provider is enabled only when both key + model are set.
# Privacy classes default to PUBLIC,INTERNAL. Add CONFIDENTIAL/RESTRICTED only after policy review.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CAPABILITIES=planning
OPENAI_PRIVACY_CLASSES=PUBLIC,INTERNAL
OPENAI_COST_PER_1K_INPUT=0
OPENAI_COST_PER_1K_OUTPUT=0

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_CAPABILITIES=planning
ANTHROPIC_PRIVACY_CLASSES=PUBLIC,INTERNAL
ANTHROPIC_COST_PER_1K_INPUT=0
ANTHROPIC_COST_PER_1K_OUTPUT=0

GOOGLE_API_KEY=
GOOGLE_MODEL=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
GOOGLE_CAPABILITIES=planning
GOOGLE_PRIVACY_CLASSES=PUBLIC,INTERNAL
GOOGLE_COST_PER_1K_INPUT=0
GOOGLE_COST_PER_1K_OUTPUT=0

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CAPABILITIES=planning
DEEPSEEK_PRIVACY_CLASSES=PUBLIC,INTERNAL
DEEPSEEK_COST_PER_1K_INPUT=0
DEEPSEEK_COST_PER_1K_OUTPUT=0

# Qwen compatible-mode base URL is region/workspace specific and must be explicit.
QWEN_API_KEY=
QWEN_MODEL=
QWEN_BASE_URL=
QWEN_CAPABILITIES=planning
QWEN_PRIVACY_CLASSES=PUBLIC,INTERNAL
QWEN_COST_PER_1K_INPUT=0
QWEN_COST_PER_1K_OUTPUT=0

# Gmail production adapter (gmail_send = YELLOW, approval gated)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
GMAIL_USER_ID=me
GMAIL_FROM_EMAIL=
GMAIL_API_BASE_URL=https://gmail.googleapis.com/gmail/v1
