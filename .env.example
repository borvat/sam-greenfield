# SAM Greenfield environment example — never commit real secrets
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sam_greenfield
POSTGRES_DB=sam_greenfield
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
HOST=0.0.0.0
PORT=8080
SAM_WORKER_ID=sam-local
SAM_TICK_INTERVAL_MS=1000
SAM_SHUTDOWN_GRACE_MS=15000
# Required in production: absolute path to a trusted composition module exporting runWorkTick()
SAM_COMPOSITION_MODULE=
# Production wiring bundle: trusted module exporting real capabilities/adapters/verifiers
SAM_PRODUCTION_BUNDLE_MODULE=
# ChatGPT / MCP transport
SAM_MCP_PORT=8081
SAM_MCP_HOST=0.0.0.0
SAM_MCP_ACTOR=chatgpt-mcp
# Required in production. Store only in secret manager / deployment environment.
SAM_MCP_BEARER_TOKEN=
# Comma-separated hostnames accepted on the MCP endpoint, e.g. mcp.example.com
SAM_MCP_ALLOWED_HOSTS=
# Optional comma-separated origins. Requests without Origin are allowed.
SAM_MCP_ALLOWED_ORIGINS=
