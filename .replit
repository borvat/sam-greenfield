# Import this branch into a NEW Replit project; provision its database first.
modules = ["nodejs-20", "bash", "postgresql-16"]
run = "npm run start:direct"

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 5000
externalPort = 80

[userenv.shared]
NODE_ENV = "production"
SAM_DATABASE_TARGET = "production"
SAM_EXECUTIVE_MCP = "1"
SAM_DB_SCHEMA = "sam"
SAM_DB_APP_ROLE = "sam_runtime"
SAM_RELEASE_SETUP_MODE = "0"
SAM_RELEASE_SYNTHETIC_PLANNER = "0"

[deployment]
deploymentTarget = "vm"
run = ["env", "NODE_ENV=production", "npm", "run", "start:direct"]
build = ["sh", "-c", "npm ci --include=dev && npm run typecheck"]
ignorePorts = false
