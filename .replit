modules = ["nodejs-20", "python-3.12", "bash", "postgresql-16"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "SAM Command Center"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "SAM Development Worker"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "SAM Read-only MCP"

[[workflows.workflow]]
name = "SAM Command Center"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev:command-center"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "SAM Development Worker"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev:runtime"
waitForPort = 8080

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "SAM Read-only MCP"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev:mcp"
waitForPort = 3001

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[userenv]

[userenv.shared]

[userenv.production]
NODE_ENV = "production"
SAM_DATABASE_TARGET = "production"
SAM_DB_CONNECTION_MODE = "direct"
SAM_DB_CONNECTION_SOURCE = "replit_managed"
SAM_DB_SCHEMA = "sam"
SAM_MCP_OAUTH_APPROVED = "0"
SAM_MCP_SYNTHETIC_TOOLS = "1"
SAM_PILOT_MAX_COST_USD = "0.01"
SAM_PILOT_MAX_REQUESTS = "1"
SAM_PRODUCTION_BUNDLE_MODULE = "apps/production/src/syntheticPilotBundleModule.ts"
SAM_RELEASE_APPROVED = "0"
SAM_RELEASE_CAPABILITIES = "local.calculate,local.statistics"
SAM_RELEASE_ENABLE_MCP = "1"
SAM_RELEASE_SETUP_LOCAL = "0"
SAM_RELEASE_SETUP_MODE = "1"
SAM_RELEASE_SYNTHETIC_PLANNER = "1"
SAM_RELEASE_SYNTHETIC_PLANNER_APPROVED = "0"
SAM_MCP_OAUTH_RESOURCE = "https://sam-greenfield.replit.app/mcp"

[deployment]
deploymentTarget = "vm"
run = ["env", "NODE_ENV=production", "npm", "run", "start:release"]
build = ["sh", "-c", "npm ci --include=dev && npm run typecheck"]
ignorePorts = false
