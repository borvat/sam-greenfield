# Never commit real values. Copy to .env.production on the server.
POSTGRES_DB=sam
POSTGRES_USER=sam
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD

# Least-privilege application logins (created by provision-roles.sql during deploy).
# POSTGRES_USER above is the owner/admin: it is used only for migrations and role
# provisioning, never by a running service. Three DISTINCT secrets, hex only:
#   openssl rand -hex 32
SAM_WORKER_DB_PASSWORD=CHANGE_ME_HEX_64
SAM_MCP_DB_PASSWORD=CHANGE_ME_HEX_64
SAM_COMMAND_CENTER_DB_PASSWORD=CHANGE_ME_HEX_64
# Credential vault master keys (per-entity bol/Gmail/... secrets are stored encrypted in
# the database; these keys are NOT stored there). Format  version:64-hex,version:64-hex
# Generate each key with `openssl rand -hex 32`. To rotate: add a new version, set it
# active, run the key rotation, then remove the old version. Back these keys up
# separately from the database: without them the stored secrets are unrecoverable.
SAM_VAULT_KEYS=1:CHANGE_ME_HEX_64
SAM_VAULT_ACTIVE_KEY_VERSION=1
# Organization id the Command Center is scoped to (row-level security context).
SAM_ORG_ID=

SAM_COMMAND_CENTER_DOMAIN=sam.example.com
SAM_MCP_DOMAIN=mcp.sam.example.com
SAM_TLS_EMAIL=admin@example.com

SAM_WORKER_ID=sam-prod-1
SAM_COMMAND_CENTER_BEARER_TOKEN=CHANGE_ME_RANDOM
SAM_COMMAND_CENTER_ALLOWED_HOSTS=sam.example.com
SAM_COMMAND_CENTER_ALLOWED_ORIGINS=https://sam.example.com
SAM_MCP_BEARER_TOKEN=CHANGE_ME_RANDOM
SAM_MCP_ALLOWED_HOSTS=mcp.sam.example.com
SAM_MCP_ALLOWED_ORIGINS=

OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GOOGLE_API_KEY=
GOOGLE_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
QWEN_API_KEY=
QWEN_MODEL=
QWEN_BASE_URL=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GMAIL_FROM_EMAIL=
EBOEKHOUDEN_API_TOKEN=
BOL_CLIENT_ID=
BOL_CLIENT_SECRET=

SAM_COMMAND_CENTER_LEGAL_ENTITY_ID=
SAM_FINANCE_LEGAL_ENTITY_ID=
SAM_FINANCE_LOOP_INTERVAL_MINUTES=180
SAM_FINANCE_LOOKBACK_DAYS=30
SAM_FINANCE_MATERIAL_VARIANCE_COUNT=1
SAM_FINANCE_MAX_PAGES=5
